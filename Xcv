-- 🔹 ฟังก์ชันสร้างปุ่ม Toggle แบบ reusable
local function createToggle(name, parent, yPos, defaultState, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 220, 0, 32)
	btn.Position = UDim2.new(0, 20, 0, yPos)
	btn.BackgroundColor3 = defaultState and Color3.fromRGB(100, 0, 160) or Color3.fromRGB(60, 60, 60)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Text = name .. ": " .. (defaultState and "ON" or "OFF")
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 14
	btn.Parent = parent
	local state = defaultState
	btn.MouseButton1Click:Connect(function()
		state = not state
		btn.Text = name .. ": " .. (state and "ON" or "OFF")
		btn.BackgroundColor3 = state and Color3.fromRGB(100, 0, 160) or Color3.fromRGB(60, 60, 60)
		callback(state)
	end)
	return btn
end

-- 🛸 ฟังก์ชัน Fly
local function setFly(active)
	if active then
		Character = LocalPlayer.Character
		if not Character then return end
		local root = Character:FindFirstChild("HumanoidRootPart")
		if not root then return end
		flyBody = Instance.new("BodyVelocity")
		flyBody.Velocity = Vector3.zero
		flyBody.MaxForce = Vector3.new(1, 1, 1) * 4000
		flyBody.Parent = root
		flyGyro = Instance.new("BodyGyro")
		flyGyro.MaxTorque = Vector3.new(1, 1, 1) * 4000
		flyGyro.CFrame = root.CFrame
		flyGyro.Parent = root
		-- ควบคุมด้วยคีย์ W A S D Space Shift
		local keys = {W = false, A = false, S = false, D = false, Space = false, LShift = false}
		local inputBegan = UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then return end
			if input.KeyCode == Enum.KeyCode.W then keys.W = true
			elseif input.KeyCode == Enum.KeyCode.A then keys.A = true
			elseif input.KeyCode == Enum.KeyCode.S then keys.S = true
			elseif input.KeyCode == Enum.KeyCode.D then keys.D = true
			elseif input.KeyCode == Enum.KeyCode.Space then keys.Space = true
			elseif input.KeyCode == Enum.KeyCode.LeftShift then keys.LShift = true
			end
		end)
		local inputEnded = UserInputService.InputEnded:Connect(function(input)
			if input.KeyCode == Enum.KeyCode.W then keys.W = false
			elseif input.KeyCode == Enum.KeyCode.A then keys.A = false
			elseif input.KeyCode == Enum.KeyCode.S then keys.S = false
			elseif input.KeyCode == Enum.KeyCode.D then keys.D = false
			elseif input.KeyCode == Enum.KeyCode.Space then keys.Space = false
			elseif input.KeyCode == Enum.KeyCode.LeftShift then keys.LShift = false
			end
		end)
		local heartbeat
		heartbeat = RunService.Heartbeat:Connect(function()
			if not flyBody or not flyGyro or not root or not root.Parent then
				heartbeat:Disconnect()
				inputBegan:Disconnect()
				inputEnded:Disconnect()
				return
			end
			local direction = Vector3.zero
			local camDir = Camera.CFrame.LookVector
			local camRight = Camera.CFrame.RightVector
			if keys.W then direction = direction + camDir end
			if keys.S then direction = direction - camDir end
			if keys.A then direction = direction - camRight end
			if keys.D then direction = direction + camRight end
			if keys.Space then direction = direction + Vector3.new(0, 1, 0) end
			if keys.LShift then direction = direction - Vector3.new(0, 1, 0) end
			local speed = 50
			flyBody.Velocity = direction * speed
			flyGyro.CFrame = CFrame.new(root.Position, root.Position + camDir)
		end)
		-- เก็บ reference เพื่อลบภายหลัง
		flyBody.Changed:Connect(function()
			if not flyBody.Parent then
				heartbeat:Disconnect()
				inputBegan:Disconnect()
				inputEnded:Disconnect()
			end
		end)
	else
		if flyBody then flyBody:Destroy() end
		if flyGyro then flyGyro:Destroy() end
		flyBody = nil
		flyGyro = nil
	end
end

