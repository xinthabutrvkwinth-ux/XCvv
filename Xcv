local function getClosestInFOV()
	local closest = nil
	local minDist = fovRadius
	local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
	for _, p in ipairs(Players:GetPlayers()) do
		if p == LocalPlayer then continue end
		local char = p.Character
		if not char then continue end
		local head = char:FindFirstChild("Head")
		local hum = char:FindFirstChild("Humanoid")
		if not head or not hum or hum.Health <= 0 then continue end
		local sp, onScreen = Camera:WorldToViewportPoint(head.Position)
		if not onScreen then continue end
		local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
		if dist < minDist then
			minDist = dist
			closest = p
		end
	end
	return closest
end

RunService.RenderStepped:Connect(function()
	local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
	-- crosshair
	crossCircle.Position = center
	crossCircle.Radius = crosshairSize
	crossDot.Position = center
	crossHLine.From = Vector2.new(center.X - crosshairSize, center.Y)
	crossHLine.To = Vector2.new(center.X + crosshairSize, center.Y)
	crossVLine.From = Vector2.new(center.X, center.Y - crosshairSize)
	crossVLine.To = Vector2.new(center.X, center.Y + crosshairSize)
	fovCircle.Position = center
	fovCircle.Radius = fovRadius

	if aimbotEnabled then
		aimbotTarget = getClosestInFOV()
		if aimbotTarget and aimbotTarget.Character and aimbotTarget.Character:FindFirstChild("Head") then
			local headPos = Camera:WorldToViewportPoint(aimbotTarget.Character.Head.Position)
			local delta = Vector2.new(headPos.X, headPos.Y) - center
			if delta.Magnitude > 1 then
				mousemoverel(delta.X * smoothness, delta.Y * smoothness)
			end
		end
	end
end)

local function setAimbot(active)
	aimbotEnabled = active
	fovCircle.Visible = active
end

