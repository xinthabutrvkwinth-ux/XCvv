-- 🦘 Infinite Jump
local function setInfJump(active)
	Humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
	if Humanoid then
		Humanoid.JumpPower = active and 100 or 50
		if active then
			-- ยอมให้กระโดดกลางอากาศ
			local uis = UserInputService
			local jumpRequest
			jumpRequest = uis.JumpRequest:Connect(function()
				if Humanoid and Humanoid.Parent then
					Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
				end
			end)
			-- ล้างเมื่อปิด
			-- (จะใช้ disconnect ภายนอก) จัดการด้วยตัวแปร
			if not _G.InfJumpConns then _G.InfJumpConns = {} end
			table.insert(_G.InfJumpConns, jumpRequest)
		else
			if _G.InfJumpConns then
				for _, conn in ipairs(_G.InfJumpConns) do conn:Disconnect() end
				_G.InfJumpConns = {}
			end
		end
	end
end

-- 🚫 NoClip
local function setNoClip(active)
	local function apply()
		for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = not active
			end
		end
	end
	if LocalPlayer.Character then apply() end
	LocalPlayer.CharacterAdded:Connect(function(char)
		if noClipEnabled then
			char:WaitForChild("Head", 5)
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end
	end)
	-- ใช้ repeat ตรวจสอบเมื่อเกิดการเปลี่ยนแปลง
end

-- 💀 God Mode
local function setGod(active)
	Humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
	if Humanoid then
		if active then
			Humanoid.Health = 9999
			Humanoid.MaxHealth = 9999
			Humanoid.Name = "GodHuman"
			-- ป้องกัน damage
			local godCon = Humanoid.HealthChanged:Connect(function()
				if godEnabled then
					Humanoid.Health = 9999
				end
			end)
			-- เก็บ connection
			if not _G.GodConns then _G.GodConns = {} end
			table.insert(_G.GodConns, godCon)
		else
			Humanoid.MaxHealth = 100
			if _G.GodConns then
				for _, conn in ipairs(_G.GodConns) do conn:Disconnect() end
				_G.GodConns = {}
			end
		end
	end
end

-- 🕷️ ESP (เรียกใช้จากสคริปเดิม)
local espFolder = nil
local function setESP(active)
	if active then
		espFolder = Instance.new("Folder")
		espFolder.Name = "ESP_👾"
		espFolder.Parent = game.CoreGui
		local function addESP(player)
			local char = player.Character
			if not char then return end
			local head = char:FindFirstChild("Head")
			local humanoid = char:FindFirstChild("Humanoid")
			local root = char:FindFirstChild("HumanoidRootPart")
			if not (head and humanoid and root) then return end
			local hl = Instance.new("Highlight")
			hl.FillColor = Color3.fromRGB(180, 0, 255)
			hl.OutlineColor = Color3.fromRGB(255,255,255)
			hl.FillTransparency = 0.5
			hl.Parent = espFolder
			local bill = Instance.new("BillboardGui")
			bill.Adornee = head
			bill.Size = UDim2.new(0,200,0,30)
			bill.StudsOffset = Vector3.new(0,2.5,0)
			bill.AlwaysOnTop = true
			local label = Instance.new("TextLabel", bill)
			label.Size = UDim2.new(1,0,1,0)
			label.BackgroundTransparency = 1
			label.TextColor3 = Color3.fromRGB(255,255,255)
			label.TextStrokeTransparency = 0
			label.Font = Enum.Font.SourceSansBold
			label.TextSize = 13
			local conn
			conn = RunService.RenderStepped:Connect(function()
				if not char or not char.Parent or not humanoid or humanoid.Health <= 0 then
					conn:Disconnect()
					hl:Destroy()
					bill:Destroy()
					return
				end
				local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				local dist = myRoot and math.floor((myRoot.Position - root.Position).Magnitude) or 0
				label.Text = string.format("%s | HP: %.0f | %dm", player.Name, humanoid.Health, dist)
			end)
		end
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then addESP(p) end
		end
		Players.PlayerAdded:Connect(function(p)
			if p ~= LocalPlayer then
				p.CharacterAdded:Connect(function() task.wait(0.3) addESP(p) end)
			end
		end)
		Players.PlayerRemoving:Connect(function(p)
			if espFolder then
				local found = espFolder:FindFirstChild(p.Name.."_HL")
				if found then found:Destroy() end
			end
		end)
	else
		if espFolder then espFolder:Destroy() end
		espFolder = nil
	end
end

