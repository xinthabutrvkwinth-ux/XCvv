local espItems = {}
local minimapFrame, minimapDots = nil, {}

-- ฟังก์ชันสร้างวงกลม Minimap ที่มุมขวาบน
local function createMinimap()
	if minimapFrame then return end
	minimapFrame = Instance.new("Frame")
	minimapFrame.Size = UDim2.new(0, 150, 0, 150)
	minimapFrame.Position = UDim2.new(1, -170, 0, 50)
	minimapFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	minimapFrame.BackgroundTransparency = 0.7
	minimapFrame.BorderSizePixel = 0
	minimapFrame.Parent = screenGui
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 75)
	corner.Parent = minimapFrame
	
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Thickness = 2
	stroke.Parent = minimapFrame
end

-- อัปเดตตำแหน่งจุดใน Minimap
local function updateMinimap()
	if not minimapFrame then return end
	local myChar = player.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
	local myPos = myChar.HumanoidRootPart.Position
	local myCFrame = myChar.HumanoidRootPart.CFrame
	local mapRadius = 70
	
	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer == player then continue end
		local otherChar = otherPlayer.Character
		if otherChar and otherChar:FindFirstChild("HumanoidRootPart") then
			local otherPos = otherChar.HumanoidRootPart.Position
			local relativePos = otherPos - myPos
			local localPos = myCFrame:Inverse() * CFrame.new(relativePos)
			local x = math.clamp(localPos.X / 50, -1, 1) * mapRadius
			local z = math.clamp(localPos.Z / 50, -1, 1) * mapRadius
			
			local dot = minimapDots[otherPlayer.UserId]
			if not dot then
				dot = Instance.new("Frame")
				dot.Size = UDim2.new(0, 8, 0, 8)
				dot.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
				dot.BorderSizePixel = 0
				local dotCorner = Instance.new("UICorner")
				dotCorner.CornerRadius = UDim.new(0, 4)
				dotCorner.Parent = dot
				dot.Parent = minimapFrame
				minimapDots[otherPlayer.UserId] = dot
			end
			dot.Position = UDim2.new(0.5, x - 4, 0.5, -z - 4)
			dot.Visible = true
		else
			if minimapDots[otherPlayer.UserId] then
				minimapDots[otherPlayer.UserId].Visible = false
			end
		end
	end
	-- ทำลาย dot ผู้เล่นที่ออก
	for userId, dot in pairs(minimapDots) do
		local found = false
		for _, p in ipairs(Players:GetPlayers()) do
			if p.UserId == userId then found = true break end
		end
		if not found then
			dot:Destroy()
			minimapDots[userId] = nil
		end
	end
end

-- สร้าง ESP เหนือหัวผู้เล่น
local function createESPForPlayer(plr)
	if espItems[plr.UserId] then return end
	local char = plr.Character
	if not char or not char:FindFirstChild("Head") then return end
	
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ESP_Billboard"
	billboard.Adornee = char.Head
	billboard.Size = UDim2.new(0, 200, 0, 40)
	billboard.StudsOffset = Vector3.new(0, 2.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = game.CoreGui
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.SourceSansBold
	label.TextSize = 13
	label.Parent = billboard
	
	local tracer = Drawing.new("Line")
	tracer.Color = Color3.fromRGB(255, 0, 0)
	tracer.Thickness = 1
	tracer.Transparency = 0.6
	tracer.Visible = true
	
	espItems[plr.UserId] = {
		billboard = billboard,
		label = label,
		tracer = tracer,
		player = plr
	}
	
	-- อัปเดตข้อมูล
	local connection
	connection = RunService.RenderStepped:Connect(function()
		if not plr.Character or not plr.Character:FindFirstChild("Humanoid") or not plr.Character:FindFirstChild("HumanoidRootPart") then
			if espItems[plr.UserId] then
				connection:Disconnect()
				espItems[plr.UserId].billboard:Destroy()
				espItems[plr.UserId].tracer:Remove()
				espItems[plr.UserId] = nil
			end
			return
		end
		local hum = plr.Character.Humanoid
		local root = plr.Character.HumanoidRootPart
		local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local dist = myRoot and math.floor((myRoot.Position - root.Position).Magnitude) or 0
		local item = espItems[plr.UserId]
		if item then
			item.label.Text = string.format("%s\n❤️%.0f | %dm", plr.Name, hum.Health, dist)
			-- Tracer
			local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
			local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
			if onScreen then
				item.tracer.From = center
				item.tracer.To = Vector2.new(screenPos.X, screenPos.Y)
				item.tracer.Visible = true
			else
				item.tracer.Visible = false
			end
		end
	end)
	espItems[plr.UserId].connection = connection
end

-- เปิด/ปิด ESP (ถูกเรียกตอนใส่ Key สำเร็จ)
function startESP()
	createMinimap()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			createESPForPlayer(p)
		end
	end
	Players.PlayerAdded:Connect(function(p)
		p.CharacterAdded:Connect(function()
			task.wait(0.5)
			createESPForPlayer(p)
		end)
	end)
	Players.PlayerRemoving:Connect(function(p)
		if espItems[p.UserId] then
			espItems[p.UserId].billboard:Destroy()
			espItems[p.UserId].tracer:Remove()
			if espItems[p.UserId].connection then espItems[p.UserId].connection:Disconnect() end
			espItems[p.UserId] = nil
		end
	end)
end

