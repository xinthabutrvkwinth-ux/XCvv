local crossCircle, crossDot, crossH, crossV, fovCircle
crossCircle = Drawing.new("Circle"); crossCircle.Visible = true; crossCircle.Color = Color3.fromRGB(255,0,0); crossCircle.Thickness = 2; crossCircle.Transparency = 0.3; crossCircle.Radius = crosshairSize
crossDot = Drawing.new("Circle"); crossDot.Visible = true; crossDot.Color = Color3.fromRGB(255,0,0); crossDot.Thickness = 1; crossDot.Radius = 2; crossDot.Filled = true
crossH = Drawing.new("Line"); crossH.Visible = true; crossH.Color = Color3.fromRGB(255,50,50); crossH.Thickness = 1; crossH.Transparency = 0.5
crossV = Drawing.new("Line"); crossV.Visible = true; crossV.Color = Color3.fromRGB(255,50,50); crossV.Thickness = 1; crossV.Transparency = 0.5
fovCircle = Drawing.new("Circle"); fovCircle.Visible = false; fovCircle.Color = Color3.fromRGB(255,0,0); fovCircle.Thickness = 1.5; fovCircle.Transparency = 0.6

local function getClosestInFOV()
	local closest = nil
	local minD = fovRadius
	local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
	for _, p in ipairs(Players:GetPlayers()) do
		if p == LocalPlayer then continue end
		local c = p.Character
		if not c then continue end
		local head = c:FindFirstChild("Head")
		local hum = c:FindFirstChild("Humanoid")
		if not head or not hum or hum.Health <= 0 then continue end
		local sp, onScr = Camera:WorldToViewportPoint(head.Position)
		if not onScr then continue end
		local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
		if d < minD then minD = d; closest = p end
	end
	return closest
end

RunService.RenderStepped:Connect(function()
	local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
	crossCircle.Position = center; crossCircle.Radius = crosshairSize
	crossDot.Position = center
	crossH.From = Vector2.new(center.X - crosshairSize, center.Y); crossH.To = Vector2.new(center.X + crosshairSize, center.Y)
	crossV.From = Vector2.new(center.X, center.Y - crosshairSize); crossV.To = Vector2.new(center.X, center.Y + crosshairSize)
	fovCircle.Position = center; fovCircle.Radius = fovRadius

	if aimbotEnabled then
		local target = getClosestInFOV()
		if target and target.Character and target.Character:FindFirstChild("Head") then
			local hp = Camera:WorldToViewportPoint(target.Character.Head.Position)
			local delta = Vector2.new(hp.X, hp.Y) - center
			if delta.Magnitude > 1 then
				mousemoverel(delta.X * smoothness, delta.Y * smoothness)
			end
		end
	end
end)

local function setAimbot(v)
	aimbotEnabled = v
	fovCircle.Visible = v
end

-- 🔴 Teleport (ไปยังจุดที่เมาส์ชี้)
local function teleportToMouse()
	local mouse = LocalPlayer:GetMouse()
	if mouse.Target then
		local pos = mouse.Hit.Position
		local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if root then root.CFrame = CFrame.new(pos + Vector3.new(0,3,0)) end
	end
end
UserInputService.InputBegan:Connect(function(input, gamep)
	if gamep then return end
	if input.KeyCode == teleportKey then
		teleportToMouse()
	end
end)

