-- 👁️ 4. ระบบ ESP (Box สีเขียว + Tracers)
-- --------------------------------------------------------
local espItems = {} -- {[userId] = {boxLines, tracerLine, connection}}
local espLoopConnection = nil

-- ฟังก์ชันสร้าง ESP สำหรับผู้เล่นหนึ่งคน
local function createESP(player)
	if espItems[player.UserId] then return end
	
	local boxLines = {}
	-- สร้าง 8 เส้นสำหรับ Corner Box (2 เส้นต่อมุม)
	for i = 1, 8 do
		local line = Drawing.new("Line")
		line.Color = Color3.fromRGB(0, 255, 0) -- เขียว
		line.Thickness = 2
		line.Transparency = 0
		line.Visible = false
		table.insert(boxLines, line)
	end
	
	local tracer = Drawing.new("Line")
	tracer.Color = Color3.fromRGB(255, 0, 0) -- แดง
	tracer.Thickness = 1
	tracer.Transparency = 0.5
	tracer.Visible = false
	
	espItems[player.UserId] = {
		boxLines = boxLines,
		tracer = tracer,
		player = player
	}
end

-- ฟังก์ชันอัปเดตตำแหน่ง Box และ Tracer
local function updateESP()
	for userId, item in pairs(espItems) do
		local plr = item.player
		local char = plr.Character
		if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
			-- ซ่อนถ้าไม่มีตัว
			for _, line in ipairs(item.boxLines) do line.Visible = false end
			item.tracer.Visible = false
			continue
		end
		
		local hrp = char.HumanoidRootPart
		local head = char:FindFirstChild("Head")
		if not head then continue end
		
		-- คำนวณขอบเขต 3D
		local minY = hrp.Position.Y - 2.5
		local maxY = head.Position.Y + 1.5
		local sizeXZ = Vector3.new(2, 0, 2) -- ขนาดด้านข้างประมาณ 2 studs
		
		local corners3D = {
			Vector3.new(hrp.Position.X - sizeXZ.X/2, minY, hrp.Position.Z - sizeXZ.Z/2),
			Vector3.new(hrp.Position.X + sizeXZ.X/2, minY, hrp.Position.Z - sizeXZ.Z/2),
			Vector3.new(hrp.Position.X - sizeXZ.X/2, maxY, hrp.Position.Z - sizeXZ.Z/2),
			Vector3.new(hrp.Position.X + sizeXZ.X/2, maxY, hrp.Position.Z - sizeXZ.Z/2),
			Vector3.new(hrp.Position.X - sizeXZ.X/2, minY, hrp.Position.Z + sizeXZ.Z/2),
			Vector3.new(hrp.Position.X + sizeXZ.X/2, minY, hrp.Position.Z + sizeXZ.Z/2),
			Vector3.new(hrp.Position.X - sizeXZ.X/2, maxY, hrp.Position.Z + sizeXZ.Z/2),
			Vector3.new(hrp.Position.X + sizeXZ.X/2, maxY, hrp.Position.Z + sizeXZ.Z/2),
		}
		
		-- Project ลง screen
		local screenPoints = {}
		local allVisible = true
		for _, pos in ipairs(corners3D) do
			local sp, onScreen = Camera:WorldToViewportPoint(pos)
			if not onScreen then allVisible = false break end
			table.insert(screenPoints, Vector2.new(sp.X, sp.Y))
		end
		
		if not allVisible then
			for _, line in ipairs(item.boxLines) do line.Visible = false end
			item.tracer.Visible = false
			continue
		end
		
		-- หา bounding box 2D
		local minX, maxX = math.huge, -math.huge
		local minY2D, maxY2D = math.huge, -math.huge
		for _, sp in ipairs(screenPoints) do
			if sp.X < minX then minX = sp.X end
			if sp.X > maxX then maxX = sp.X end
			if sp.Y < minY2D then minY2D = sp.Y end
			if sp.Y > maxY2D then maxY2D = sp.Y end
		end
		
		local w = maxX - minX
		local h = maxY2D - minY2D
		local cornerLen = math.min(w, h) * 0.25 -- ความยาวมุม 25%
		
		-- กำหนดมุม 4 มุม (ซ้ายบน, ขวาบน, ซ้ายล่าง, ขวาล่าง)
		local function drawCorner(startX, startY, dirX, dirY)
			local lines = {}
			lines[1] = {From = Vector2.new(startX, startY), To = Vector2.new(startX + dirX * cornerLen, startY)}
			lines[2] = {From = Vector2.new(startX, startY), To = Vector2.new(startX, startY + dirY * cornerLen)}
			return lines
		end
		
		local corners = {
			drawCorner(minX, minY2D, 1, 1),   -- ซ้ายบน
			drawCorner(maxX, minY2D, -1, 1),  -- ขวาบน
			drawCorner(minX, maxY2D, 1, -1),  -- ซ้ายล่าง
			drawCorner(maxX, maxY2D, -1, -1), -- ขวาล่าง
		}
		
		-- อัปเดตเส้น 8 เส้น
		local lineIdx = 1
		for _, corner in ipairs(corners) do
			for _, seg in ipairs(corner) do
				local line = item.boxLines[lineIdx]
				if line then
					line.From = seg.From
					line.To = seg.To
					line.Visible = true
				end
				lineIdx = lineIdx + 1
			end
		end
		
		-- Tracer
		local myChar = player.Character
		if myChar and myChar:FindFirstChild("HumanoidRootPart") then
			local myRootPos = myChar.HumanoidRootPart.Position
			local myScreen, myOn = Camera:WorldToViewportPoint(myRootPos)
			local targetScreen, targetOn = Camera:WorldToViewportPoint(hrp.Position)
			if myOn and targetOn then
				item.tracer.From = Vector2.new(myScreen.X, myScreen.Y)
				item.tracer.To = Vector2.new(targetScreen.X, targetScreen.Y)
				item.tracer.Visible = true
			else
				item.tracer.Visible = false
			end
		else
			item.tracer.Visible = false
		end
	end
end

function toggleESP(active)
	if active then
		-- เปิด ESP
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player then
				createESP(plr)
			end
		end
		-- จัดการผู้เล่นใหม่
		local function onPlayerAdded(plr)
			if plr ~= player then
				plr.CharacterAdded:Connect(function()
					task.wait(0.5)
					createESP(plr)
				end)
			end
		end
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player then onPlayerAdded(plr) end
		end
		Players.PlayerAdded:Connect(onPlayerAdded)
		Players.PlayerRemoving:Connect(function(plr)
			if espItems[plr.UserId] then
				for _, line in ipairs(espItems[plr.UserId].boxLines) do
					line:Remove()
				end
				espItems[plr.UserId].tracer:Remove()
				espItems[plr.UserId] = nil
			end
		end)
		-- เริ่ม loop อัปเดต
		if not espLoopConnection then
			espLoopConnection = RunService.RenderStepped:Connect(updateESP)
		end
	else
		-- ปิด ESP
		if espLoopConnection then
			espLoopConnection:Disconnect()
			espLoopConnection = nil
		end
		for _, item in pairs(espItems) do
			for _, line in ipairs(item.boxLines) do line:Remove() end
			item.tracer:Remove()
		end
		espItems = {}
	end
end

