        btn.Size = UDim2.new(0, 40, 1, 0)
        btn.Position = UDim2.new(0.75, 0, 0, 0)
        btn.BackgroundColor3 = getter() and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(100, 100, 100)
