-- ==================== ESP แสดงบทบาทภาษาไทย ====================
local function UpdateESP()
    if not Features.ESP then
        if espGui then espGui.Enabled = false end
        return
    end
    if not espGui then
        espGui = Instance.new("ScreenGui")
        espGui.Name = "AongtongESP"
        espGui.Parent = LocalPlayer.PlayerGui
        espFrames = {}
    end
    espGui.Enabled = true

    local count = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            count = count + 1
        end
    end
    while #espFrames > count do
        local f = table.remove(espFrames)
        if f then f:Destroy() end
    end

    local idx = 1
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local root = player.Character.HumanoidRootPart
            local screenPos, onScreen = Camera:WorldToScreenPoint(root.Position)
            local frame = espFrames[idx]
            if not frame then
                frame = Instance.new("Frame")
                frame.BackgroundTransparency = 0.35
                frame.BorderSizePixel = 2
                frame.BorderColor3 = Color3.new(1,1,1)
                frame.Size = UDim2.new(0, 130, 0, 55)
                frame.Parent = espGui
                local nameLbl = Instance.new("TextLabel")
                nameLbl.Name = "Name"
                nameLbl.Size = UDim2.new(1,0, 0.35,0)
                nameLbl.Position = UDim2.new(0,0, 0,0)
                nameLbl.BackgroundTransparency = 1
                nameLbl.TextScaled = true
                nameLbl.Font = Enum.Font.SourceSansBold
                nameLbl.TextColor3 = Color3.new(1,1,1)
                nameLbl.Parent = frame
                local roleLbl = Instance.new("TextLabel")
                roleLbl.Name = "Role"
                roleLbl.Size = UDim2.new(1,0, 0.3,0)
                roleLbl.Position = UDim2.new(0,0, 0.35,0)
                roleLbl.BackgroundTransparency = 1
                roleLbl.TextScaled = true
                roleLbl.Font = Enum.Font.SourceSansBold
                roleLbl.TextColor3 = Color3.new(1,1,0)
                roleLbl.Parent = frame
                local weaponLbl = Instance.new("TextLabel")
                weaponLbl.Name = "Weapon"
                weaponLbl.Size = UDim2.new(1,0, 0.3,0)
                weaponLbl.Position = UDim2.new(0,0, 0.65,0)
                weaponLbl.BackgroundTransparency = 1
                weaponLbl.TextScaled = true
                weaponLbl.Font = Enum.Font.SourceSans
                weaponLbl.TextColor3 = Color3.new(0.8,0.8,0.8)
                weaponLbl.Parent = frame
                local box = Instance.new("Frame")
                box.Name = "Box"
                box.Size = UDim2.new(0, 50, 0, 80)
                box.Position = UDim2.new(0, -25, 0, -40)
                box.BackgroundTransparency = 0.7
                box.BorderSizePixel = 2
                box.BorderColor3 = Color3.new(0,1,0)
                box.Visible = Features.BoxESP
                box.Parent = frame
                local tracer = Instance.new("Frame")
                tracer.Name = "Tracer"
                tracer.Size = UDim2.new(0, 2, 0, screenPos.Y)
                tracer.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y - screenPos.Y)
                tracer.BackgroundColor3 = Color3.new(0,1,0)
                tracer.BackgroundTransparency = 0.5
                tracer.Visible = Features.Tracer
                tracer.Parent = frame
                espFrames[idx] = frame
            end
            if onScreen then
                frame.Visible = true
                frame.Position = UDim2.new(0, screenPos.X - 65, 0, screenPos.Y - 65)
                local roleThai, weapon = GetPlayerRoleThai(player)
                local color = Color3.new(0, 0.7, 0)
                local icon = "👤"
                if roleThai == "นายอำเภอ" then
                    color = Color3.new(0, 0.4, 1)
                    icon = "👮"
                elseif roleThai == "ฆาตกร" then
                    color = Color3.new(0.8, 0, 0)
                    icon = "🔪"
                end
                frame.BackgroundColor3 = color
                frame.Name.Text = Features.ShowName and player.Name or ""
                frame.Role.Text = icon .. " " .. roleThai
                frame.Weapon.Text = (Features.ShowWeapon and weapon) and ("🗡️ " .. weapon) or ""
                local box = frame:FindFirstChild("Box")
                if box then box.Visible = Features.BoxESP end
                local tracer = frame:FindFirstChild("Tracer")
                if tracer then
                    tracer.Visible = Features.Tracer
                    tracer.Size = UDim2.new(0, 2, 0, screenPos.Y)
                    tracer.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y - screenPos.Y)
                end
            else
                frame.Visible = false
            end
            idx = idx + 1
        end
    end
end

-- ==================== AutoFarm ====================
local function AutoFarm()
    if not Features.AutoFarm then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    local target = nil
    local minDist = Features.FarmRange + 1
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:match("Coin|Gem|Crystal|Key|Health|Diamond") and obj.Parent ~= char then
            local dist = (obj.Position - root.Position).Magnitude
            if dist < minDist then
                minDist = dist; target = obj
            end
        end
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj.Name ~= LocalPlayer.Name then
            local dist = (obj.HumanoidRootPart.Position - root.Position).Magnitude
            if dist < minDist then
                minDist = dist; target = obj.HumanoidRootPart
            end
        end
    end
    if target then
        char.Humanoid:MoveTo(target.Position)
        if (target.Position - root.Position).Magnitude < 4 then
            if target.Parent and target.Parent:FindFirstChild("Humanoid") then
                target.Parent.Humanoid.Health = 0
            else
                target:Destroy()
            end
        end
    end
end

-- ==================== SpeedBoost ====================
local function SpeedBoost()
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
    if not humanoid then return end
    if Features.Speed then humanoid.WalkSpeed = Features.SpeedValue
    elseif humanoid.WalkSpeed == Features.SpeedValue then humanoid.WalkSpeed = 16 end
end

-- ==================== JumpBoost ====================
local function JumpBoost()
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
    if not humanoid then return end
    if Features.Jump then humanoid.JumpPower = Features.JumpValue
    elseif humanoid.JumpPower == Features.JumpValue then humanoid.JumpPower = 50 end
end

-- ==================== NoClip ====================
local function NoClip()
    if not LocalPlayer.Character then return end
    for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = not Features.NoClip end
    end
end

-- ==================== Fly ====================
local function Fly()
    if Features.Fly then
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        if not flying then
            flying = true
            flyBV = Instance.new("BodyVelocity")
            flyBV.MaxForce = Vector3.new(100000, 100000, 100000)
            flyBV.Velocity = Vector3.new(0, Features.FlySpeed, 0)
            flyBV.Parent = char.HumanoidRootPart
        end
        if flyBV then
            local move = Vector3.new(0,0,0)
            local look = Camera.CFrame.LookVector
            local right = Camera.CFrame.RightVector
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + look * Features.FlySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - look * Features.FlySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - right * Features.FlySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + right * Features.FlySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, Features.FlySpeed, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then move = move - Vector3.new(0, Features.FlySpeed, 0) end
            flyBV.Velocity = move
        end
    else
        if flyBV then flyBV:Destroy(); flyBV = nil end
        flying = false
    end
end

-- ==================== AntiAFK ====================
local function AntiAFK()
    if not Features.AntiAFK then return end
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
    if humanoid and humanoid.RootPart then
        humanoid:MoveTo(humanoid.RootPart.Position + Vector3.new(math.random(-2,2), 0, math.random(-2,2)))
    end
end

