-- ==================== ฟังก์ชันตรวจจับบทบาท (ภาษาไทย) ====================
local function GetPlayerRoleThai(player)
    if not player or not player.Character then return "คนดี", nil end
    local function checkTool(container)
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                local name = tool.Name:lower()
                if name:find("knife") or name:find("dagger") or name:find("blade") then
                    return "ฆาตกร", tool.Name
                elseif name:find("gun") or name:find("pistol") or name:find("revolver") or name:find("sheriff") then
                    return "นายอำเภอ", tool.Name
                end
            end
        end
        return nil, nil
    end
    local role, weapon = checkTool(player.Character)
    if role then return role, weapon end
    if player.Backpack then
        role, weapon = checkTool(player.Backpack)
        if role then return role, weapon end
    end
    return "คนดี", nil
end

-- ==================== X-Ray (มองทะลุ) ====================
local function ApplyXRay(enable)
    if enable then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character) then
                if obj.Parent and not obj.Parent:IsA("Model") or (obj.Parent:IsA("Model") and obj.Parent.Name ~= LocalPlayer.Name) then
                    local origTrans = obj.Transparency
                    if origTrans < 0.9 then
                        obj.Transparency = 0.4
                        table.insert(xrayParts, {obj, origTrans})
                    end
                end
            end
        end
    else
        for _, data in ipairs(xrayParts) do
            local part = data[1]
            local orig = data[2]
            if part and part.Parent then
                part.Transparency = orig
            end
        end
        xrayParts = {}
    end
end

