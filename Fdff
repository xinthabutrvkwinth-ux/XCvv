        elseif tab == "Visuals" then BuildVisualsTab()
        elseif tab == "Player" then BuildPlayerTab()
        end
        local count = #contentFrame:GetChildren()
        contentFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(300, count * 30))
    end
