    -- ==================== ฟังก์ชันสร้าง Slider (ขนาดเล็ก) ====================
    local function CreateSlider(parent, label, getter, setter, min, max, step)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -6, 0, 34)
        row.Position = UDim2.new(0, 3, 0, #parent:GetChildren() * 28)
        row.BackgroundTransparency = 1
        row.Parent = parent

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0.6, 0, 0.4, 0)
        lbl.Position = UDim2.new(0, 0, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = label .. ": " .. tostring(getter())
        lbl.TextColor3 = Color3.new(1,1,1)
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextScaled = true
        lbl.Font = Enum.Font.SourceSans
        lbl.Parent = row

        local slider = Instance.new("Frame")
        slider.Size = UDim2.new(0.7, 0, 0.3, 0)
        slider.Position = UDim2.new(0, 0, 0.5, 0)
        slider.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
        slider.BorderSizePixel = 1
        slider.Parent = row

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new((getter()-min)/(max-min), 0, 1, 0)
        fill.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        fill.BorderSizePixel = 0
        fill.Parent = slider

        local drag = Instance.new("TextButton")
        drag.Size = UDim2.new(0, 12, 1, 0)
        drag.Position = UDim2.new((getter()-min)/(max-min), -6, 0, 0)
        drag.BackgroundColor3 = Color3.new(1,1,1)
        drag.BorderSizePixel = 1
        drag.Text = ""
        drag.Parent = slider

        local function updateSlider(val)
            val = math.clamp(val, min, max)
            val = math.round(val / step) * step
            setter(val)
            lbl.Text = label .. ": " .. tostring(val)
            fill.Size = UDim2.new((val-min)/(max-min), 0, 1, 0)
            drag.Position = UDim2.new((val-min)/(max-min), -6, 0, 0)
        end

        drag.MouseButton1Down:Connect(function()
            local connection
            connection = UserInputService.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement then
                    local rel = (input.Position.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X
                    updateSlider(min + rel * (max - min))
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    if connection then connection:Disconnect() end
                end
            end)
        end)
        return row
    end

