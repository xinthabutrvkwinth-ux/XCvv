-- ❤️‍🩹 ปุ่มหยุดลูป
local btnStop = Instance.new("TextButton")
btnStop.Size = UDim2.new(0, 120, 0, 35)
btnStop.Position = UDim2.new(0.65, 0, 0.75, 0)
btnStop.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
btnStop.TextColor3 = Color3.fromRGB(255, 255, 255)
btnStop.Font = Enum.Font.SourceSansBold
btnStop.TextSize = 16
btnStop.Text = "Stop ❤️‍🩹"
btnStop.Parent = main

-- 🌚 ตัวแปรควบคุมลูป
local isLooping = false
local loopThread = nil

-- 👾 ฟังก์ชันรันสคริปต์จากกล่อง
local function execute()
	local code = scriptBox.Text
	local f, syntaxErr = loadstring(code)
	if not f then
		warn("❄️ Syntax Error: " .. tostring(syntaxErr))
		return
	end
	local success, runtimeErr = pcall(f)
	if not success then
		warn("🕷️ Runtime Error: " .. tostring(runtimeErr))
	end
end

-- 🔨 ปุ่ม Run Once
btnOnce.MouseButton1Click:Connect(function()
	execute()
end)

-- 🦠 ปุ่ม Run Loop
btnLoop.MouseButton1Click:Connect(function()
	if isLooping then return end
	isLooping = true
	loopThread = task.spawn(function()
		while isLooping do
			execute()
			task.wait(0.05)  -- หน่วงเล็กน้อยกันค้าง
		end
	end)
end)

-- ❤️‍🩹 ปุ่มหยุด
btnStop.MouseButton1Click:Connect(function()
	isLooping = false
	if loopThread then
		task.cancel(loopThread)
		loopThread = nil
	end
end)
