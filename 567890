crossV = Drawing.new("Line"); crossV.Visible=true; crossV.Color=Color3.fromRGB(255,50,50); crossV.Thickness=1; crossV.Transparency=0.5
fovCircle = Drawing.new("Circle"); fovCircle.Visible=false; fovCircle.Color=Color3.fromRGB(255,0,0); fovCircle.Thickness=1.5; fovCircle.Transparency=0.6

local function getClosestInFOV()
	local closest, minD = nil, fovRadius
	local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
	for _,p in ipairs(Players:GetPlayers()) do
		if p==LocalPlayer then continue end
		local c=p.Character; if not c then continue end
		local head=c:FindFirstChild("Head"); local hum=c:FindFirstChild("Humanoid"); if not head or not hum or hum.Health<=0 then continue end
		local sp,onScr = Camera:WorldToViewportPoint(head.Position); if not onScr then continue end
		local d = (Vector2.new(sp.X,sp.Y)-center).Magnitude
		if d<minD then minD=d; closest=p end
	end
	return closest
end

-- 🎥 ฟังก์ชันหันกล้องตามเป้า (Camera Follow)
local cameraFollowTarget = nil
local savedCameraType, savedCameraSubject
local function setCameraFollow(active)
	cameraFollowEnabled = active
	if active then
		-- บันทึกสถานะกล้องเดิม
		savedCameraType = Camera.CameraType
		savedCameraSubject = Camera.CameraSubject
		Camera.CameraType = Enum.CameraType.Scriptable
		-- หาเป้าเริ่มต้น (ใช้เป้าจาก Aimbot ถ้ามี หรือตัวใกล้สุดใน FOV)
		cameraFollowTarget = aimbotEnabled and getClosestInFOV() or getClosestInFOV()
		-- หากไม่มีใครเลย ให้กลับเป็นไม่ทำงาน
		if not cameraFollowTarget then
			Camera.CameraType = savedCameraType
			Camera.CameraSubject = savedCameraSubject
			cameraFollowEnabled = false
			return
		end
		-- วนอัปเดตกล้อง
		task.spawn(function()
			while cameraFollowEnabled do
				if not cameraFollowTarget or not cameraFollowTarget.Character or not cameraFollowTarget.Character:FindFirstChild("Head") then
					-- หาใหม่
					cameraFollowTarget = aimbotEnabled and getClosestInFOV() or getClosestInFOV()
					if not cameraFollowTarget then
						-- ไม่มีใครเลย หยุด
						cameraFollowEnabled = false
						break
					end
				end
				local head = cameraFollowTarget.Character.Head
				-- ให้กล้องมองจากตำแหน่งผู้เล่นไปที่หัวเป้า
				local myHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
				if myHead then
					local lookAt = CFrame.lookAt(myHead.Position, head.Position)
					Camera.CFrame = lookAt
				else
					-- fallback
					Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, head.Position)
				end
				task.wait()
			end
			-- ออกจากโหมด
			Camera.CameraType = savedCameraType or Enum.CameraType.Custom
			Camera.CameraSubject = savedCameraSubject or LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
		end)
	else
		cameraFollowEnabled = false
		Camera.CameraType = savedCameraType or Enum.CameraType.Custom
		Camera.CameraSubject = savedCameraSubject or LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
	end
end

-- อัปเดต Crosshair/Aimbot ทุกเฟรม
RunService.RenderStepped:Connect(function()
	local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
	crossCircle.Position = center; crossCircle.Radius = crosshairSize
	crossDot.Position = center
	crossH.From = Vector2.new(center.X-crosshairSize,center.Y); crossH.To = Vector2.new(center.X+crosshairSize,center.Y)
	crossV.From = Vector2.new(center.X,center.Y-crosshairSize); crossV.To = Vector2.new(center.X,center.Y+crosshairSize)
	fovCircle.Position = center; fovCircle.Radius = fovRadius

	if aimbotEnabled then
		local target = getClosestInFOV()
		if target and target.Character and target.Character:FindFirstChild("Head") then
			local hp = Camera:WorldToViewportPoint(target.Character.Head.Position)
			local delta = Vector2.new(hp.X,hp.Y)-center
			if delta.Magnitude>1 then mousemoverel(delta.X*smoothness, delta.Y*smoothness) end
		end
	end
end)

local function setAimbot(v)
	aimbotEnabled = v
	fovCircle.Visible = v
end

-- 🔴 Teleport
local function teleportToMouse()
	local mouse = LocalPlayer:GetMouse()
	if mouse.Target then
		local pos = mouse.Hit.Position
		local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if root then root.CFrame = CFrame.new(pos+Vector3.new(0,3,0)) end
	end
end
UserInputService.InputBegan:Connect(function(input,gp)
	if gp then return end
	if input.KeyCode == teleportKey then teleportToMouse() end
end)

