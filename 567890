-- 🔹 ฟังก์ชันสร้าง Toggle
local function createToggle(name, yPos, default, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 220, 0, 33)
	btn.Position = UDim2.new(0, 30, 0, yPos)
	btn.BackgroundColor3 = default and Color3.fromRGB(150, 10, 10) or Color3.fromRGB(40, 40, 40)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Text = name .. ": " .. (default and "ON" or "OFF")
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 14
	btn.Parent = mainFrame
	local state = default
	btn.MouseButton1Click:Connect(function()
		state = not state
		btn.Text = name .. ": " .. (state and "ON" or "OFF")
		btn.BackgroundColor3 = state and Color3.fromRGB(150, 10, 10) or Color3.fromRGB(40, 40, 40)
		callback(state)
	end)
	return btn
end

-- 🔴 ฟังก์ชัน Fly
local flyBody, flyGyro, flyConnections = nil, nil, {}
local function setFly(active)
	if active then
		local char = LocalPlayer.Character; if not char then return end
		local root = char:FindFirstChild("HumanoidRootPart"); if not root then return end
		flyBody = Instance.new("BodyVelocity"); flyBody.Velocity = Vector3.zero; flyBody.MaxForce = Vector3.new(1e4,1e4,1e4); flyBody.Parent = root
		flyGyro = Instance.new("BodyGyro"); flyGyro.MaxTorque = Vector3.new(1e5,1e5,1e5); flyGyro.Parent = root
		local keys = {W=false,A=false,S=false,D=false,Space=false,Shift=false}
		local function onInput(input,gp) if gp then return end
			if input.KeyCode==Enum.KeyCode.W then keys.W=true elseif input.KeyCode==Enum.KeyCode.A then keys.A=true
			elseif input.KeyCode==Enum.KeyCode.S then keys.S=true elseif input.KeyCode==Enum.KeyCode.D then keys.D=true
			elseif input.KeyCode==Enum.KeyCode.Space then keys.Space=true elseif input.KeyCode==Enum.KeyCode.LeftShift then keys.Shift=true end
		end
		local function onEnd(input)
			if input.KeyCode==Enum.KeyCode.W then keys.W=false elseif input.KeyCode==Enum.KeyCode.A then keys.A=false
			elseif input.KeyCode==Enum.KeyCode.S then keys.S=false elseif input.KeyCode==Enum.KeyCode.D then keys.D=false
			elseif input.KeyCode==Enum.KeyCode.Space then keys.Space=false elseif input.KeyCode==Enum.KeyCode.LeftShift then keys.Shift=false end
		end
		flyConnections[1]=UserInputService.InputBegan:Connect(onInput); flyConnections[2]=UserInputService.InputEnded:Connect(onEnd)
		flyConnections[3]=RunService.Heartbeat:Connect(function()
			if not flyBody or not flyBody.Parent then return end
			local cam=Camera.CFrame; local dir=Vector3.zero
			if keys.W then dir+=cam.LookVector end; if keys.S then dir-=cam.LookVector end
			if keys.A then dir-=cam.RightVector end; if keys.D then dir+=cam.RightVector end
			if keys.Space then dir+=Vector3.new(0,1,0) end; if keys.Shift then dir-=Vector3.new(0,1,0) end
			flyBody.Velocity=dir*60; flyGyro.CFrame=CFrame.lookAt(root.Position,root.Position+cam.LookVector)
		end)
	else
		if flyBody then flyBody:Destroy(); flyBody=nil end; if flyGyro then flyGyro:Destroy(); flyGyro=nil end
		for _,c in ipairs(flyConnections) do c:Disconnect() end; flyConnections={}
	end
end

